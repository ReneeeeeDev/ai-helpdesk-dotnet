{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [ "format", "SupportAI.sln", "--verify-no-changes", "--no-restore", "--include", "${staged}" ],
      "include": [ "**/*.cs" ]
    }
  ]
}
