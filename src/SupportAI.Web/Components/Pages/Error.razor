@page "/error"
@layout EmptyLayout

<PageTitle>Error · SupportAI</PageTitle>

<MudPaper Class="pa-8 w-100" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-2"><b>Algo salió mal</b></MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Ocurrió un error inesperado. Si persiste, comparte con soporte la hora aproximada en que ocurrió.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Volver al inicio</MudButton>
</MudPaper>
