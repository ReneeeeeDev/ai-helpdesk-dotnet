@page "/tickets/{Id:guid}"
@implements IAsyncDisposable
@inject SupportAIApiClient Api
@inject TicketHubClient Hub
@inject SessionStore Session
@inject ISnackbar Snackbar

<PageTitle>@(_ticket is null ? "Ticket" : $"#{_ticket.Summary.Number} {_ticket.Summary.Subject}") · SupportAI</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">El ticket no existe o no tienes acceso.</MudAlert>
    return;
}

@if (_ticket is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

@{ var t = _ticket.Summary; }

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@(Session.IsStaff ? "inbox" : "my-tickets")" aria-label="Volver" />
    <MudText Typo="Typo.h5"><b>#@t.Number · @t.Subject</b></MudText>
    <StatusChip Status="t.Status" />
    <PriorityChip Priority="t.Priority" />
    @if (Session.IsStaff)
    {
        <SlaIndicator DueAt="t.ResolutionDueAt" Breached="t.SlaBreached" Status="t.Status" />
        @if (t.NeedsHumanReview)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.PersonSearch">Requiere revisión</MudChip>
        }
    }
</MudStack>

<MudGrid Spacing="4">
    <MudItem xs="12" md="@(Session.IsStaff ? 8 : 12)">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
            <MudTabPanel Text="Conversación" Icon="@Icons.Material.Filled.Forum">
                <MudStack Spacing="3">
                    <div class="sai-message customer">
                        <MudText Typo="Typo.caption"><b>@(t.RequesterName ?? "Cliente")</b> · @Ui.Date(t.CreatedAt) · vía @t.Channel</MudText>
                        <div class="sai-pre mt-1">@_ticket.Description</div>
                    </div>

                    @foreach (var m in _ticket.Messages)
                    {
                        var css = m.IsInternal ? "internal" : m.AuthorType == MessageAuthorType.Customer ? "customer" : "agent";
                        <div class="sai-message @css">
                            <MudText Typo="Typo.caption">
                                <b>@(m.AuthorName ?? m.AuthorType.ToString())</b> · @Ui.Date(m.CreatedAt)
                                @if (m.IsInternal)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Nota interna</MudChip>
                                }
                            </MudText>
                            <div class="sai-pre mt-1">@m.Body</div>
                        </div>
                    }

                    @if (t.Status != TicketStatus.Closed)
                    {
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            @if (_suggestion is not null)
                            {
                                <MudAlert Severity="@(_suggestion.ShouldEscalate ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3"
                                          ShowCloseIcon="true" CloseIconClicked="DiscardSuggestionAsync">
                                    Borrador generado por IA (confianza @Ui.Percent((double)_suggestion.Confidence)).
                                    @if (_suggestion.ShouldEscalate)
                                    {
                                        <b> La IA recomienda escalar este caso.</b>
                                    }
                                    @if (_suggestion.Citations.Count > 0)
                                    {
                                        <div class="mt-1">
                                            Fuentes:
                                            @foreach (var c in _suggestion.Citations)
                                            {
                                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.MenuBook" Href="@($"knowledge/{c.ArticleId}")" Target="_blank">@c.Title</MudChip>
                                            }
                                        </div>
                                    }
                                </MudAlert>
                            }

                            <MudTextField T="string" @bind-Value="_reply" Label="@(Session.IsStaff ? "Responder al cliente" : "Añadir un mensaje")" Variant="Variant.Outlined" Lines="5" Immediate="true" />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                                @if (Session.IsStaff)
                                {
                                    <MudCheckBox T="bool" @bind-Value="_internal" Label="Nota interna" Color="Color.Warning" />
                                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="SuggestAsync" Disabled="_suggesting">
                                        @(_suggesting ? "Generando…" : "Sugerir respuesta con IA")
                                    </MudButton>
                                }
                                <MudSpacer />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Send"
                                           Disabled="@(_sending || string.IsNullOrWhiteSpace(_reply))" OnClick="SendAsync">Enviar</MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>

            @if (Session.IsStaff)
            {
                <MudTabPanel Text="Historial" Icon="@Icons.Material.Filled.History" BadgeData="@_ticket.Activities.Count">
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @foreach (var a in _ticket.Activities.OrderByDescending(a => a.OccurredAt))
                        {
                            <MudTimelineItem Size="Size.Small" Color="@(a.Type == "SlaBreached" ? Color.Error : a.Type == "Triaged" ? Color.Primary : Color.Default)">
                                <MudText Typo="Typo.body2">@a.Description</MudText>
                                <MudText Typo="Typo.caption">@(a.ActorName ?? "Sistema / IA") · @Ui.Date(a.OccurredAt)</MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudTabPanel>
            }
        </MudTabs>
    </MudItem>

    @if (Session.IsStaff)
    {
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <MudCard Elevation="0" Outlined="true">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1"><b>Gestión</b></MudText></CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        @if (_ticket.AllowedTransitions.Count > 0)
                        {
                            <MudText Typo="Typo.caption">Cambiar estado</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
                                @foreach (var s in _ticket.AllowedTransitions)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Ui.StatusColor(s)" Disabled="_saving" OnClick="() => ChangeStatusAsync(s)">@Ui.StatusLabel(s)</MudButton>
                                }
                            </MudStack>
                        }

                        <MudSelect T="TicketPriority" Label="Prioridad" Value="t.Priority" ValueChanged="ChangePriorityAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_saving || t.Status == TicketStatus.Closed)">
                            @foreach (var p in Enum.GetValues<TicketPriority>())
                            {
                                <MudSelectItem T="TicketPriority" Value="@p">@Ui.PriorityLabel(p)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="Guid?" Label="Equipo" @bind-Value="_teamId" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                            @foreach (var team in _teams)
                            {
                                <MudSelectItem T="Guid?" Value="@team.Id">@team.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="Guid?" Label="Agente asignado" @bind-Value="_assigneeId" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                            @foreach (var agent in _agents)
                            {
                                <MudSelectItem T="Guid?" Value="@agent.Id">@agent.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudStack Row="true" Class="mt-2">
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="AssignToMe">Asignarme</MudButton>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || !AssignmentChanged)" OnClick="AssignAsync">Guardar asignación</MudButton>
                        </MudStack>

                        <MudDivider Class="my-3" />
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                <tr><td>Primera respuesta</td><td>@(_ticket.FirstRespondedAt is { } fr ? Ui.Date(fr) : $"vence {Ui.Relative(t.FirstResponseDueAt)}")</td></tr>
                                <tr><td>Resolución</td><td>@Ui.Date(t.ResolutionDueAt)</td></tr>
                                <tr><td>Idioma</td><td>@(_ticket.Language?.ToUpperInvariant() ?? "—")</td></tr>
                                <tr><td>Tags</td><td>@(_ticket.Tags.Count == 0 ? "—" : string.Join(", ", _ticket.Tags))</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>

                <TriagePanel TicketId="Id" Triage="_ticket.LatestTriage" Categories="_categories" Teams="_teams" OnChanged="LoadAsync" />
                <SummaryPanel TicketId="Id" />

                <MudExpansionPanels Elevation="0" Outlined="true">
                    <MudExpansionPanel Text="Copiloto sobre este ticket" Icon="@Icons.Material.Filled.AutoAwesome">
                        <CopilotChat TicketId="Id" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudStack>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public Guid Id { get; set; }

    private TicketDetailDto? _ticket;
    private bool _notFound;
    private IReadOnlyList<string> _categories = [];
    private List<TeamDto> _teams = [];
    private List<MemberDto> _agents = [];
    private Guid? _teamId;
    private Guid? _assigneeId;
    private string? _reply;
    private bool _internal;
    private bool _sending;
    private bool _saving;
    private bool _suggesting;
    private SuggestedReplyDto? _suggestion;

    private bool AssignmentChanged => _ticket is not null && (_teamId != _ticket.Summary.TeamId || _assigneeId != _ticket.Summary.AssigneeId);

    protected override async Task OnInitializedAsync()
    {
        Hub.TicketChanged += OnTicketChanged;
        await Hub.EnsureStartedAsync();

        if (Session.IsStaff)
        {
            // Datos de referencia en paralelo.
            var teams = Api.GetTeamsAsync();
            var agents = Api.GetAgentsAsync();
            var categories = Api.GetCategoriesAsync();
            await Task.WhenAll(teams, agents, categories);
            _teams = teams.Result;
            _agents = agents.Result.Where(m => m.Role != UserRole.Customer && m.IsActive).ToList();
            _categories = categories.Result;
        }
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _ticket = await Api.GetTicketAsync(Id);
            _teamId = _ticket.Summary.TeamId;
            _assigneeId = _ticket.Summary.AssigneeId;
        }
        catch (ApiException ex) when (ex.Status == HttpStatusCode.NotFound)
        {
            _notFound = true;
        }
    }

    private async Task SendAsync()
    {
        _sending = true;
        try
        {
            await Api.AddMessageAsync(Id, new AddMessageRequest(_reply!, _internal));
            if (_suggestion is not null)
            {
                await Api.ResolveSuggestedReplyAsync(Id, _suggestion.Id, used: true);
                _suggestion = null;
            }

            _reply = null;
            _internal = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task SuggestAsync()
    {
        _suggesting = true;
        try
        {
            _suggestion = await Api.SuggestReplyAsync(Id);
            _reply = _suggestion.Body;
            _internal = false;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Code == "quota_exceeded" ? "Se agotó el presupuesto de IA del mes." : ex.Message, Severity.Warning);
        }
        finally
        {
            _suggesting = false;
        }
    }

    private async Task DiscardSuggestionAsync()
    {
        if (_suggestion is not null)
        {
            await Api.ResolveSuggestedReplyAsync(Id, _suggestion.Id, used: false);
            _suggestion = null;
            _reply = null;
        }
    }

    private Task ChangeStatusAsync(TicketStatus status) => SaveAsync(() => Api.ChangeStatusAsync(Id, status, _ticket!.RowVersion), $"Estado: {Ui.StatusLabel(status)}");

    private Task ChangePriorityAsync(TicketPriority priority) => SaveAsync(() => Api.ChangePriorityAsync(Id, priority, _ticket!.RowVersion), $"Prioridad: {Ui.PriorityLabel(priority)}");

    private Task AssignAsync() => SaveAsync(() => Api.AssignAsync(Id, _assigneeId, _teamId, _ticket!.RowVersion), "Asignación actualizada");

    private void AssignToMe()
    {
        _assigneeId = Session.User?.Id;
        _teamId ??= Session.User?.TeamId;
    }

    /// <summary>Envía el cambio con If-Match; si otra persona modificó el ticket (409), recarga y avisa.</summary>
    private async Task SaveAsync(Func<Task> action, string successMessage)
    {
        _saving = true;
        try
        {
            await action();
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (ApiException ex) when (ex.Status == HttpStatusCode.Conflict)
        {
            Snackbar.Add("Otra persona modificó el ticket. Se recargó con los datos actuales.", Severity.Warning);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            await LoadAsync();
            _saving = false;
        }
    }

    private Task OnTicketChanged(TicketChangedNotification notification) => notification.TicketId != Id
        ? Task.CompletedTask
        : InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    public ValueTask DisposeAsync()
    {
        Hub.TicketChanged -= OnTicketChanged;
        return ValueTask.CompletedTask;
    }
}
