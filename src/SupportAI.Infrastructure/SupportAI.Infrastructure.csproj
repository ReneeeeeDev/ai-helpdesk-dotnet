<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SupportAI.Application\SupportAI.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prompts versionados: se embeben en el ensamblado y se sincronizan a la BD al arrancar. -->
    <EmbeddedResource Include="Ai\Prompts\**\*.md;Ai\Prompts\**\*.json" LogicalName="prompts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SupportAI.Application.Tests" />
    <InternalsVisibleTo Include="SupportAI.Api.IntegrationTests" />
    <InternalsVisibleTo Include="SupportAI.PromptEvals" />
    <InternalsVisibleTo Include="SupportAI.MrReviewer" />
  </ItemGroup>
</Project>
